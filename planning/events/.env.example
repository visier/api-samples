# Visier auth (used by visier_platform_sdk)
VISIER_HOST=https://customer-specific.ai.visier.io
VISIER_APIKEY=visier-provided-api-key
VISIER_USERNAME=visier-username
VISIER_PASSWORD=visier-password
VISIER_VANITY=visier-tenant-vanity-name

# Sample configuration
# Required. The ID of the plan to poll for promotion events
PLAN_ID=your-plan-id

# Optional. How far back to look for promotion events, in minutes (default: 5)
LOOKBACK_MINUTES=5

# Optional. Process at most this many of the most recent promotion events (default: 10)
MAX_EVENTS=10

# The plan item column to populate in the upload CSV (e.g. Headcount_And_Cost_Planning.Headcount)
PLAN_ITEM_ID=your-plan-item-id
