APP_MODE=demo
PORT=5050
STATE_DB=instance/promotion.sqlite3
# Optional override of the public origin. Databricks Apps supplies DATABRICKS_APP_URL automatically;
# set this only for another TLS-terminating proxy.
# PUBLIC_ORIGIN=https://your-app.example.com
# Install requirements using your organization's configured Artifactory pip index.
# Set APP_MODE=live after completing both tenant configurations.
SOURCE_NAME=Development
TARGET_NAME=Production
SOURCE_HOST=https://your-dev.api.visier.io
# Optional; leave blank when the server does not require an API key.
SOURCE_APIKEY=
SOURCE_VANITY=
SOURCE_USERNAME=
SOURCE_PASSWORD=
# Optional TargetTenantID override for access through an administrating tenant.
# Use the actual tenant ID, not its vanity name; leave blank for direct login.
SOURCE_TENANT_ID=
# Optional OAuth credentials; omit for basic authentication.
SOURCE_CLIENT_ID=
SOURCE_CLIENT_SECRET=
TARGET_HOST=https://your-prod.api.visier.io
# Optional; leave blank when the server does not require an API key.
TARGET_APIKEY=
TARGET_VANITY=
TARGET_USERNAME=
TARGET_PASSWORD=
# Optional TargetTenantID override; leave blank for direct login.
TARGET_TENANT_ID=
TARGET_CLIENT_ID=
TARGET_CLIENT_SECRET=
# Optional: use SOURCE_ACCESS_TOKEN / TARGET_ACCESS_TOKEN instead of username/password.
# Optional: seed an existing, verified sync relationship. Both IDs are required.
# Seeds a missing checkpoint only. Use Reset sync baseline in the app for later changes.
INITIAL_SOURCE_VERSION_ID=
INITIAL_TARGET_VERSION_ID=
